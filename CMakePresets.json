{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-vs2022-debug",
      "displayName": "Windows MSVC v143 x64 Debug",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/vscode-msvc-debug",
      "architecture": "x64",
      "toolset": "v143",
      "cacheVariables": {
        "CORE_ENGINE_ENABLE_DILIGENT": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-vs2022-debug",
      "configurePreset": "windows-msvc-vs2022-debug",
      "configuration": "Debug",
      "jobs": 32,
      "targets": [
        "sandbox"
      ]
    }
  ]
}
